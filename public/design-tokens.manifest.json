{
  "colors": {
    "color-background": "hsl(var(--background))",
    "color-card": "hsl(var(--card))",
    "color-muted": "hsl(var(--muted))",
    "color-primary": "hsl(var(--primary))",
    "color-success": "hsl(var(--success))",
    "color-border": "hsl(var(--border))"
  },
  "typography": {
    "type-display-xl": { "fontSize": "40px", "lineHeight": 1.2, "fontWeight": 700 },
    "type-h1": { "fontSize": "32px", "lineHeight": 1.25, "fontWeight": 700 },
    "type-h2": { "fontSize": "24px", "lineHeight": 1.3, "fontWeight": 700 },
    "type-body-lg": { "fontSize": "16px", "lineHeight": 1.6, "fontWeight": 400 },
    "type-body": { "fontSize": "14px", "lineHeight": 1.6, "fontWeight": 400 },
    "type-caption": { "fontSize": "11px", "lineHeight": 1.3, "fontWeight": 600 }
  },
  "spacing": {
    "space-xxs": 4,
    "space-xs": 8,
    "space-sm": 12,
    "space-md": 16,
    "space-lg": 24,
    "space-xl": 32
  },
  "layout": {
    "canvasWidth": 1440,
    "columns": 12,
    "gutter": 24,
    "outerMargin": 24,
    "containers": { "wide": 1200, "default": 960, "narrow": 720 }
  },
  "elevation": {
    "elevation-0": "none",
    "elevation-1": "0 1px 3px rgba(0,0,0,0.04)",
    "elevation-2": "0 2px 8px rgba(0,0,0,0.06)",
    "elevation-3": "0 4px 12px rgba(0,0,0,0.08)",
    "elevation-4": "0 8px 24px rgba(0,0,0,0.10)",
    "elevation-5": "0 16px 32px rgba(0,0,0,0.16)"
  }
}
